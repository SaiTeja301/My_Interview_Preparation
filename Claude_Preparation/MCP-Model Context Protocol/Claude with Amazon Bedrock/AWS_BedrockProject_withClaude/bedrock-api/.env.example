# =============================================================
# .env.example — Environment Variable Template
# =============================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to git (it is in .gitignore)
#
# PREFERRED: Use AWS IAM Roles or AWS CLI profiles instead of
#            hardcoding credentials even in .env
# =============================================================

# ---- AWS Credentials ----------------------------------------
# Preferred: Leave empty and use IAM Role or `aws configure`
# Fallback:  Set below only for local development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_REGION=ap-south-1

# ---- AWS Profile (alternative to explicit keys) -------------
# If using AWS CLI profiles, set this instead:
# AWS_PROFILE=dev

# ---- Database -----------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/linkedin_naukr_jobs
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# ---- Spring Profile -----------------------------------------
SPRING_PROFILES_ACTIVE=dev
